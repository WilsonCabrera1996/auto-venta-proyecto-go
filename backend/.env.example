PORT=8080
APP_ENV=development

# Origenes del frontend (Vercel) separados por coma. Sin esto el navegador
# bloquea todas las llamadas por ser origenes distintos.
CORS_ALLOWED_ORIGINS=http://localhost:4321,https://autoventa.vercel.app

MAX_BODY_BYTES=1048576
LOG_LEVEL=info

# Sesiones
SESSION_TTL=8h

# Cuenta del dueño, sembrada solo en el primer arranque.
# En Render esto va en el panel de variables de entorno, NUNCA en el repo.
OWNER_EMAIL=dueno@autoventa.com
# Password del dueño. Solo se usa para sembrar la cuenta en el PRIMER arranque
# (repo en memoria). Después cámbialo y no lo subas: en Render esto va en el
# panel de variables de entorno.
OWNER_PASSWORD=cambiar-esto-por-algo-unico
